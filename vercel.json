{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin/login", "destination": "/admin/login/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/api/products/:id", "destination": "/api/products?id=:id" },
    { "source": "/api/orders/customer/:mobile", "destination": "/api/orders?customer=:mobile" },
    { "source": "/api/admin/orders/:id/status", "destination": "/api/admin/orders?id=:id&action=status" },
    { "source": "/api/admin/orders/:id", "destination": "/api/admin/orders?id=:id" },
    { "source": "/api/admin/products/:id", "destination": "/api/admin/products?id=:id" }
  ]
}